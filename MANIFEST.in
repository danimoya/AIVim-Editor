include LICENSE README.md VERSION pyproject.toml requirements.txt requirements-lock.txt uv.lock example-settings.json example_config
recursive-include aivim *.py *.typed *.html *.css *.js
recursive-include verification *.py
recursive-include tests *.py
recursive-include scripts *.py *.md
recursive-include .github *.yml
include docs/RELEASE.md
global-exclude *.pyc
prune __pycache__
prune models
prune build
prune dist
